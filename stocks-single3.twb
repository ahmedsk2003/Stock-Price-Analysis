      <aliases enabled='yes' />
      <column datatype='real' default-format='c&quot;₹ &quot;#,##0,.00K;&quot;₹ &quot;-#,##0,.00K' name='[52W H]' role='measure' type='quantitative' />
      <column datatype='real' default-format='c&quot;₹ &quot;#,##0,.00K;&quot;₹ &quot;-#,##0,.00K' name='[52W L]' role='measure' type='quantitative' />
      <column caption='Close' datatype='real' default-format='c&quot;₹ &quot;#,##0,.00K;&quot;₹ &quot;-#,##0,.00K' name='[CLOSE]' role='measure' type='quantitative' />
      <column caption='Moving avg. 50' datatype='real' name='[Calculation_1280154025295872]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(AVG([CLOSE]),-50,0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Daily Return' datatype='real' name='[Calculation_1280154026582018]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([CLOSE] - [PREV. CLOSE])/[PREV. CLOSE]' />
      </column>
      <column caption='Candle Size' datatype='real' name='[Calculation_1280154054627332]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ABS([OPEN]-[CLOSE])' />
      </column>
      <column caption='Price Direction' datatype='string' name='[Calculation_1280154055315461]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [CLOSE]&gt;[OPEN]THEN &apos;Up&apos; &#13;&#10;ELSE &apos;Down&apos;&#13;&#10;END' />
      </column>
      <column caption='Direction' datatype='string' name='[Calculation_1280154121564166]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [CLOSE]&gt;[OPEN] THEN &quot;UP&quot;&#13;&#10;ELSE &quot;Down&quot;&#13;&#10;END' />
      </column>
      <column caption='Date' datatype='date' name='[DATE]' role='dimension' type='ordinal' />
      <column aggregation='None' datatype='integer' name='[Daily Return (bin)]' role='dimension' type='quantitative'>
        <calculation class='bin' decimals='-3' formula='[Calculation_1280154026582018]' peg='0' size='0.0095' />
      </column>
      <column caption='High' datatype='real' name='[HIGH]' role='measure' type='quantitative' />
      <column aggregation='Min' datatype='real' name='[LOW]' role='measure' type='quantitative' />
      <column caption='No. Of  Trades' datatype='integer' name='[NO. OF  TRADES]' role='measure' type='quantitative' />
      <column caption='Open' datatype='real' name='[OPEN]' role='measure' type='quantitative' />
