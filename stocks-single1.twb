    <worksheet name='Daily Return Histogram'>
      <table>
        <view>
          <datasources>
            <datasource caption='Quote-Equity-ADANIENT-EQ-10-03- (Quote-Equity-ADANIENT-EQ-10-03-2025-10-03-2026.csv)' name='federated.0ij6h8g0sn2nxi1bo7tyk0ak1wcc' />
