            </column>
            <column caption='Prev. Close' datatype='real' name='[PREV. CLOSE]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1280154026582018]' derivation='Count' name='[cnt:Calculation_1280154026582018:qk]' pivot='key' type='quantitative' />
